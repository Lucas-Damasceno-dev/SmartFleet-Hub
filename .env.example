# ==========================================
# SmartFleet Hub - Environment Variables
# Copy this file to .env and fill in your values
# ==========================================

# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=smartfleet
POSTGRES_PASSWORD=smartfleet_secret_dev
POSTGRES_DB=smartfleet
POSTGRES_PORT=5432

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=smartfleet
KEYCLOAK_PORT=8081

# --- Kafka ---
KAFKA_BROKER_ID=1
KAFKA_PORT=9092
KAFKA_UI_PORT=8090

# --- Redis ---
REDIS_PORT=6379

# --- Debezium ---
DEBEZIUM_PORT=8083

# --- Observability ---
GRAFANA_PORT=3000
TEMPO_PORT=3200

# --- External APIs (User must fill these for production) ---
GOOGLE_MAPS_API_KEY=AIzaSy_PLACEHOLDER
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER
FIREBASE_CREDENTIALS_PATH=./firebase-admin.json

# --- Feature Toggles ---
SIMULATION_ENABLED=true
MOCK_GEO_SERVICE=false

# --- JWT / Auth ---
JWT_ISSUER_URI=http://localhost:8081/realms/smartfleet
